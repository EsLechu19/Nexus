# Nexus Backend — Variables de entorno
# Copia este archivo a .env y completa los valores. NUNCA commitees .env
# Uso: $env:JWT_SECRET_KEY="..." (PowerShell) o export JWT_SECRET_KEY="..." (bash)

# Base de datos — PostgreSQL en producción, SQLite en dev
# Ejemplo Postgres: postgresql://usuario:password@localhost:5432/nexus
DATABASE_URL=sqlite:///nexus.db

# JWT — mínimo 32 bytes, genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-minimo-32-caracteres-aleatorios!!

# Entorno
ENV=development
