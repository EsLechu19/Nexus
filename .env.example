# Configuración local de desarrollo. Nunca commitees el .env real.
APP_ENV=development
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/nexus_dev
JWT_SECRET_KEY=replace-with-a-local-secret-of-at-least-32-characters

# PostgreSQL 18 is mandatory for the application, Alembic, integration tests, and CI.
# nexus_dev is the empty development database; no data is copied automatically.
# Do not use SQLite URLs or place credentials in source control.
